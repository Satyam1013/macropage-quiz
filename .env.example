PORT=3000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/macropage-quiz

# Secret used to sign admin JWTs
JWT_SECRET=change-me-to-a-long-random-string

# Single hardcoded admin account, bootstrapped automatically on server start
ADMIN_EMAIL=admin@macropage.in
ADMIN_PASSWORD=change-me

# Anthropic API (used for the "Analyze My Business" report)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Comma-separated list of allowed CORS origins (or "*" for all)
CORS_ORIGIN=http://localhost:5173,https://quiz.macropage.in

# WhatsApp result message, sent via macropage-connect's public API when a
# quiz session ends. Template variables: {{1}} Customer Name, {{2}} Business
# Name, {{3}} Rank got, {{4}} out of (total participants), {{5}} business
# (tech-readiness) score.
WHATSAPP_API_BASE_URL=https://api.macropageconnect.com
API_ANALYSE_QUIZ_KEY=
TEMPLATE_NAME_ANALYSE=quiz_result_delivery_final
